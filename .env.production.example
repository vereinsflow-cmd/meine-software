# =============================================================================
# VereinsFlow – Umgebungsvariablen für den PRODUKTIONSBETRIEB (docker-compose.prod.yml)
#
#   cp .env.production.example .env.production
#
# Alle Werte mit "change-me" MÜSSEN ersetzt werden – der Server startet sonst nicht (absichtlich).
# `.env.production` enthält Geheimnisse: niemals committen, nur für den Betreiber lesbar (chmod 600).
# Erklärung aller Variablen: docs/OPERATIONS.md
# =============================================================================

# --- Anwendung ---------------------------------------------------------------
# Öffentliche Adresse – MUSS mit https:// beginnen.
APP_URL=https://verein.example.org
# true, wenn ein vertrauenswürdiger Reverse-Proxy X-Forwarded-For setzt (siehe docs/OPERATIONS.md).
TRUST_PROXY=true

# --- Datenbank ---------------------------------------------------------------
# Passwort des Datenbank-Benutzers. Zufällig erzeugen, z. B.: openssl rand -base64 24
# (Leer lassen führt zu einer Fehlermeldung von Docker Compose.)
POSTGRES_PASSWORD=

# --- Geheimnisse (zufällig erzeugen!) -----------------------------------------
# Mindestens 32 Zeichen:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-generate-a-random-secret-with-at-least-32-characters
# Mindestens 16 Zeichen – schützt den Cron-Endpunkt.
CRON_SECRET=change-me-generate-another-random-secret

# --- Sitzungen -----------------------------------------------------------------
SESSION_IDLE_MINUTES=60
SESSION_MAX_DAYS=14

# --- E-Mail (in Produktion smtp) ------------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_FROM="Mein Verein <noreply@verein.example.org>"
SMTP_HOST=smtp.example.org
SMTP_PORT=587
# true bei Port 465 (implizites TLS), false bei 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Dateiablage ---------------------------------------------------------------
# Im Container liegt sie unter /data/storage (Volume "storage"); nur ändern, wenn du die Compose-Datei anpasst.
MAX_UPLOAD_MB=10
CLUB_STORAGE_QUOTA_MB=1024

# --- Hilfe & Support -------------------------------------------------------------
# Optional: technischer Support des Betreibers (erscheint unter „Hilfe & Support“ und auf der öffentlichen Seite
# /konto-loeschen für Löschanfragen ohne Zugang – für die Android-App im Play Store setzen).
SUPPORT_EMAIL=

# --- Android-App (Trusted Web Activity) -------------------------------------------
# Paketname und SHA-256-Fingerabdruck des App-Signaturschlüssels (Play Console → App-Integrität → App-Signatur),
# mehrere durch Kommas. Leer = keine App mit dieser Adresse verknüpft (siehe docs/OPERATIONS.md, „App-Ansicht“).
ANDROID_APP_PACKAGE=com.vereinsflow.app
ANDROID_APP_CERT_SHA256=

# --- Push-Benachrichtigungen (Web Push, VAPID) ------------------------------------
# Optional: alle drei setzen oder alle leer lassen (leer = Push abgeschaltet). Schlüsselpaar erzeugen mit
#   npx web-push generate-vapid-keys
# Den privaten Schlüssel geheim halten und sichern; bei einem Wechsel müssen alle Geräte Push neu einschalten.
# VAPID_SUBJECT: mailto:adresse@beispiel.de (erreichbare Adresse des Betreibers) oder eine https://-Adresse.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
