# =============================================================================
# VereinsFlow – Umgebungsvariablen
#
# Diese Datei ist die Vorlage. Kopiere sie nach `.env` und passe die Werte an:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# WICHTIG: Die Werte unten sind ausschließlich für die LOKALE ENTWICKLUNG gedacht.
# In Produktion müssen alle Secrets neu und zufällig erzeugt werden.
# `.env` darf niemals ins Repository committet werden (steht in .gitignore).
# =============================================================================

# --- Anwendung ---------------------------------------------------------------
# Öffentliche Basis-URL der Anwendung (für Links in E-Mails, Origin-Prüfung, iCal).
APP_URL=http://localhost:3000
# Auf "true" setzen, wenn die Anwendung hinter einem vertrauenswürdigen Reverse-Proxy läuft,
# der den Header X-Forwarded-For setzt (nötig für IP-basiertes Rate-Limiting).
TRUST_PROXY=false

# --- Datenbank (PostgreSQL) --------------------------------------------------
# Laufzeit-Verbindung der Anwendung.
DATABASE_URL=postgresql://vereinsflow:vereinsflow@localhost:5432/vereinsflow
# Optional: separate Verbindung für Migrationen (z. B. Owner-Rolle, wenn die
# Anwendung mit einer eingeschränkten Rolle läuft). Fällt auf DATABASE_URL zurück.
# MIGRATION_DATABASE_URL=

# --- Sicherheit --------------------------------------------------------------
# Geheimer Schlüssel (mindestens 32 Zeichen, zufällig!). Dient zum Verschlüsseln
# sensibler Felder (z. B. 2FA-Secrets) und zum Signieren interner Werte.
# Erzeugen:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=dev-only-secret-change-me-at-least-32-chars-long!

# Automatische Abmeldung nach Inaktivität (Minuten) und maximale Sitzungsdauer (Tage).
SESSION_IDLE_MINUTES=60
SESSION_MAX_DAYS=14

# Geheimnis für den Cron-Endpunkt (POST /api/cron/run mit "Authorization: Bearer <Wert>").
CRON_SECRET=dev-only-cron-secret-change-me

# --- E-Mail ------------------------------------------------------------------
# MAIL_TRANSPORT:
#   log   – E-Mails werden nur in der Server-Konsole ausgegeben (Standard für Entwicklung)
#   file  – E-Mails werden als JSON nach .local/outbox/ geschrieben (für E2E-Tests)
#   smtp  – Versand über SMTP (z. B. Mailpit lokal: localhost:1025, Weboberfläche :8025)
MAIL_TRANSPORT=log
MAIL_FROM="VereinsFlow <noreply@vereinsflow.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Dateiablage -------------------------------------------------------------
# Verzeichnis für hochgeladene Dateien. Muss AUSSERHALB von /public liegen.
STORAGE_DIR=./storage
# Maximale Dateigröße pro Upload in Megabyte.
MAX_UPLOAD_MB=10
# Gesamter Speicherplatz für Dokumente je Verein in Megabyte (danach sind keine Uploads mehr möglich).
CLUB_STORAGE_QUOTA_MB=1024

# --- Hilfe & Support ----------------------------------------------------------
# Optional: E-Mail-Adresse des technischen Supports (Plattformbetreiber). Erscheint unter „Hilfe & Support“
# für Fragen, die der Verein selbst nicht klären kann. Leer lassen, wenn es keinen gibt.
SUPPORT_EMAIL=

# --- Seed-Daten (nur lokale Entwicklung!) ------------------------------------
# Passwort für alle Demo-Benutzer, die `npm run db:seed` anlegt.
SEED_PASSWORD=Vereinsflow-Demo-2026!
