// =============================================================================
// VereinsFlow – Datenmodell
//
// Mandantenfähigkeit (Shared Database, Shared Schema):
//   * Der Verein (Club) ist der Mandant. Jede mandantenbezogene Tabelle trägt `clubId`.
//   * Beziehungen zwischen mandantenbezogenen Tabellen sind als ZUSAMMENGESETZTE
//     Fremdschlüssel (clubId, id) modelliert. Dadurch kann die Datenbank selbst
//     keine Zeile eines Vereins mit einer Zeile eines anderen Vereins verknüpfen –
//     unabhängig davon, ob der Anwendungscode einen Fehler enthält.
//   * Globale Tabellen (User, Session, Permission, VerificationToken, RateLimitBucket)
//     tragen bewusst keine clubId.
//
// Konventionen:
//   * IDs: UUIDv7 (zeitlich sortierbar, nicht erratbar).
//   * Zeitstempel: timestamptz(3), immer UTC gespeichert; Anzeige in Europe/Berlin.
//   * Reine Kalendertage (Geburtsdatum, Eintritt, Fälligkeit): @db.Date.
//   * Weiche Löschung: `deletedAt`; Archivierung: `archivedAt`.
//   * Felder `*ById` ohne Relation sind reine Herkunftsangaben (Audit) ohne Fremdschlüssel,
//     damit Benutzer datenschutzkonform entfernt werden können.
//   * Optionale zusammengesetzte Relationen nutzen `onDelete: Restrict`, weil "SetNull" die
//     Pflichtspalte clubId mit auf NULL setzen würde. Das Aufräumen übernimmt der Service.
//   * CHECK-Constraints (z. B. endsAt > startsAt) stehen in den SQL-Migrationen.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum ClubStatus {
  ACTIVE
  DEACTIVATED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

/// Reichweite einer Berechtigung: ganzer Verein, nur eigene Abteilung(en) oder nur eigene Daten.
enum PermissionScope {
  CLUB
  DEPARTMENT
  OWN
}

enum MemberStatus {
  ACTIVE
  PASSIVE
  LEFT
  HONORARY
  BLOCKED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum EventType {
  EVENT
  TRAINING
  MEETING
  COMPETITION
  WORK_ASSIGNMENT
  OTHER
}

enum EventVisibility {
  INTERNAL
  PUBLIC
}

enum ParticipantStatus {
  ACCEPTED
  DECLINED
  WAITLISTED
}

enum ShiftStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum AssignmentStatus {
  CONFIRMED
  CANCELLED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  SYSTEM
  SHIFT_ASSIGNED
  SHIFT_CHANGED
  SHIFT_CANCELLED
  SHIFT_REMINDER
  EVENT_PUBLISHED
  EVENT_CHANGED
  EVENT_CANCELLED
  EVENT_REMINDER
  TASK_ASSIGNED
  MESSAGE
  INVITATION
}

enum EmailStatus {
  NONE
  PENDING
  SENT
  FAILED
}

enum MessageStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum MessageAudience {
  ALL_MEMBERS
  DEPARTMENT
  EVENT_PARTICIPANTS
  EVENT_HELPERS
}

enum ConsentType {
  PRIVACY_POLICY
  DATA_PROCESSING
  NEWSLETTER
  PHOTO_PUBLICATION
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum DocumentAccess {
  ALL_MEMBERS
  BOARD
  ADMIN
  /// Belege im Kassenbuch: sichtbar nur mit dem Recht „Finanzen ansehen“.
  FINANCE
}

/// Zahlungsstand einer Rechnung: offen (muss noch bezahlt werden) oder bezahlt.
enum InvoiceStatus {
  OPEN
  PAID
}

/// Art eines Geldkontos im Kassenbuch: Bankkonto (Girokonto), Barkasse oder sonstiges (z. B. PayPal).
enum FinanceAccountKind {
  BANK
  CASH
  OTHER
}

/// Steuerlicher Bereich einer Einnahme/Ausgabe (gemeinnütziger Verein): neutral (Umbuchung, Anfangsbestand) · ideeller
/// Bereich · Vermögensverwaltung · Zweckbetrieb · wirtschaftlicher Geschäftsbetrieb.
enum Sphere {
  NEUTRAL
  NON_PROFIT
  ASSET_MANAGEMENT
  PURPOSE_OPERATION
  COMMERCIAL
}

/// Wofür eine Kategorie gedacht ist: Einnahmen, Ausgaben oder beides.
enum CategoryDirection {
  INCOME
  EXPENSE
  BOTH
}

/// Art einer Buchung: gewöhnlich, Storno (Gegenbuchung), Anfangsbestand eines Kontos oder Umbuchung zwischen Konten.
enum LedgerEntryKind {
  STANDARD
  REVERSAL
  OPENING
  TRANSFER
}

/// Lückenlose Nummernkreise je Verein (und meist je Jahr).
/// Beitragsart: Grundbeitrag (nach Regeln: Status, Alter, Abteilung), Zusatzbeitrag einer Abteilung, Aufnahmegebühr,
/// Familienbeitrag.
enum FeeTypeKind {
  BASE
  ADDITIONAL
  ADMISSION
  FAMILY
}

/// Zeitraum, für den ein Beitragssatz gilt (bzw. der Beitragslauf rechnet).
enum FeeInterval {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ONCE
}

enum PaymentMethod {
  TRANSFER
  DIRECT_DEBIT
  CASH
}

/// Feste Beitragsart, Befreiung, Ermäßigung in Prozent oder fester Betrag je Monat.
enum FeeAssignmentKind {
  ASSIGN
  EXEMPT
  DISCOUNT_PERCENT
  FIXED_AMOUNT
}

/// Beitrag beim Eintritt: ab dem Tag, ab Monatsanfang, ab dem Folgemonat oder für den ganzen Zeitraum.
enum ProRataEntry {
  DAY
  MONTH_START
  NEXT_MONTH
  NONE
}

/// Beitrag beim Austritt: bis zum Tag, bis Monatsende oder bis Ende des Zeitraums.
enum ProRataExit {
  DAY
  MONTH_END
  PERIOD_END
}

/// Alter für die Beitragsart: genau am Tag, zu Beginn des Zeitraums oder nach Jahrgang.
enum AgeRule {
  EXACT_DAY
  PERIOD_START
  CALENDAR_YEAR
}

/// Monatsabschluss bzw. Jahresabschluss (Dezember).
enum PeriodCloseKind {
  MONTH
  YEAR
}

enum CounterKind {
  LEDGER
  CHARGE
  FEE_RUN
  SEPA_BATCH
  RECEIPT
  MANDATE
}

enum SupportCategory {
  PROBLEM
  QUESTION
  IDEA
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  DONE
}

/// Stand eines Beitrittsantrags: offen (wartet auf den Vorstand), angenommen (Mitglied angelegt) oder abgelehnt.
enum MembershipApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ----------------------------------------------------------------------------
// Plattform: Benutzer, Sitzungen, Tokens (global, ohne clubId)
// ----------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid(7))
  /// Immer klein geschrieben gespeichert (Constraint in der Migration).
  email              String    @unique
  emailVerifiedAt    DateTime? @db.Timestamptz(3)
  /// Argon2id-Hash. Niemals das Klartextpasswort speichern oder loggen.
  passwordHash       String
  firstName          String
  lastName           String
  /// Superadministrator der Plattform (verwaltet Vereine, sieht KEINE Mitgliederdaten).
  isPlatformAdmin    Boolean   @default(false)
  /// TOTP-Secret, AES-256-GCM-verschlüsselt (optionale Zwei-Faktor-Authentifizierung).
  totpSecretEnc      String?
  totpEnabledAt      DateTime? @db.Timestamptz(3)
  /// Einmal-Wiederherstellungscodes, als Hash gespeichert.
  recoveryCodeHashes String[]
  lastLoginAt        DateTime? @db.Timestamptz(3)
  termsAcceptedAt    DateTime? @db.Timestamptz(3)
  termsVersion       String?
  emailNotifications Boolean   @default(true)
  disabledAt         DateTime? @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  memberships        ClubMembership[]
  sessions           Session[]
  verificationTokens VerificationToken[]

  @@index([deletedAt])
}

model Session {
  /// SHA-256 des Sitzungstokens (das Token selbst steht nur im Cookie des Browsers).
  id           String   @id
  userId       String
  activeClubId String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime @default(now()) @db.Timestamptz(3)
  /// Absolutes Ablaufdatum unabhängig von Aktivität.
  expiresAt    DateTime @db.Timestamptz(3)
  userAgent    String?
  /// Gekürzte IP (letztes Oktett bzw. Suffix entfernt) – Datensparsamkeit.
  ipPrefix     String?

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeClub Club? @relation(fields: [activeClubId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String                @id @default(uuid(7))
  userId    String
  type      VerificationTokenType
  /// SHA-256 des Tokens aus dem E-Mail-Link.
  tokenHash String                @unique
  /// Nur bei EMAIL_CHANGE: die neue Adresse.
  newEmail  String?
  expiresAt DateTime              @db.Timestamptz(3)
  usedAt    DateTime?             @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

/// Datenbankgestütztes Rate-Limiting (funktioniert auch mit mehreren Server-Instanzen).
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

/// Globaler Katalog aller Berechtigungen. Quelle der Wahrheit ist der Code
/// (src/server/permissions/catalog.ts); die Tabelle wird beim Seeden synchronisiert.
model Permission {
  key         String   @id
  module      String
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  rolePermissions RolePermission[]
}

// ----------------------------------------------------------------------------
// Mandant: Verein, Mitgliedschaft, Rollen
// ----------------------------------------------------------------------------

model Club {
  id                 String     @id @default(uuid(7))
  name               String
  /// URL-tauglicher, eindeutiger Kurzname.
  slug               String     @unique
  status             ClubStatus @default(ACTIVE)
  timezone           String     @default("Europe/Berlin")
  contactEmail       String?
  phone              String?
  street             String?
  postalCode         String?
  city               String?
  website            String?
  /// Ansprechpartner für Datenschutzanfragen (erscheint in den Datenschutzhinweisen).
  privacyContact     String?
  /// Aufbewahrungsfristen und weitere Vereinseinstellungen.
  settings           Json       @default("{}")
  /// Vereinslogo: zufälliger Schlüssel der Datei unter STORAGE_DIR/<clubId>/ (nie der Dateiname). Alle logo*-Felder
  /// sind gemeinsam gesetzt oder gemeinsam leer (Prüfregel in der Migration).
  /// Einrichtung des Vereins (Assistent „Verein einrichten“) abgeschlossen; leer = noch nicht – bis dahin sieht der Vereinsadministrator nur den Assistenten.
  setupCompletedAt   DateTime?  @db.Timestamptz(3)
  logoStorageKey     String?    @unique
  /// Medientyp des Logos aus der Positivliste (PNG, JPEG, WebP) – nie die Angabe des Browsers.
  logoMimeType       String?
  logoSizeBytes      Int?
  /// Prüfsumme der Logo-Datei; ihr Anfang dient als Version in der Bildadresse (Zwischenspeicher).
  logoSha256         String?
  logoUpdatedAt      DateTime?  @db.Timestamptz(3)
  /// Beitritt per QR-Code: zufälliger Schlüssel des öffentlichen Antragslinks (`/beitreten/<joinToken>`), leer = geschlossen.
  /// Bewusst im Klartext (nicht als Hash): Er gewährt keinen Zugang, sondern erlaubt nur, einen Antrag einzureichen, und
  /// muss für Nachdrucke des Aushangs wieder anzeigbar sein. „Neuen Code erzeugen“ ersetzt ihn – alte Aushänge sind dann ungültig.
  joinToken          String?    @unique
  joinTokenCreatedAt DateTime?  @db.Timestamptz(3)
  /// Höchstzahl der Anträge über den aktuellen QR-Code (1–5000, Prüfregel in der Migration); leer = unbegrenzt.
  joinLimit          Int?
  /// Eingegangene Anträge über den aktuellen QR-Code (neuer Code: wieder 0; abgelehnte geben ihren Platz zurück).
  joinUsed           Int        @default(0)
  deactivatedAt      DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  roles                  Role[]
  memberships            ClubMembership[]
  members                Member[]
  departments            Department[]
  groups                 Group[]
  events                 Event[]
  tasks                  Task[]
  checklists             Checklist[]
  messages               Message[]
  documents              Document[]
  invoices               Invoice[]
  financeSettings        FinanceSettings?
  financeAccounts        FinanceAccount[]
  financeCategories      FinanceCategory[]
  financeCounters        FinanceCounter[]
  ledgerEntries          LedgerEntry[]
  ledgerLines            LedgerLine[]
  ledgerAttachments      LedgerAttachment[]
  financePeriodCloses    FinancePeriodClose[]
  memberStatusChanges    MemberStatusChange[]
  feeTypes               FeeType[]
  feeRates               FeeRate[]
  memberFinances         MemberFinance[]
  memberFeeAssignments   MemberFeeAssignment[]
  cashCounts             CashCount[]
  folders                DocumentFolder[]
  invitations            Invitation[]
  sessions               Session[]
  supportTickets         SupportTicket[]
  membershipApplications MembershipApplication[]
}

model Role {
  id          String   @id @default(uuid(7))
  clubId      String
  /// Systemrollen: CLUB_ADMIN, BOARD, DEPARTMENT_LEAD, HELPER, MEMBER. Eigene Rollen: "custom:<name>".
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  club        Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships ClubMembership[]
  invitations Invitation[]

  @@unique([clubId, id])
  @@unique([clubId, key])
}

model RolePermission {
  clubId        String
  roleId        String
  permissionKey String
  scope         PermissionScope @default(CLUB)

  role       Role       @relation(fields: [clubId, roleId], references: [clubId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([clubId])
}

/// Zugehörigkeit eines Benutzers zu einem Verein (ein Benutzer kann mehreren Vereinen angehören).
model ClubMembership {
  id              String           @id @default(uuid(7))
  clubId          String
  userId          String
  roleId          String
  status          MembershipStatus @default(ACTIVE)
  joinedAt        DateTime         @default(now()) @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  /// Eigene Anordnung des Dashboards (Karten je Reiter: Reihenfolge, ausgeblendet); leer = Standard der Rolle.
  dashboardLayout Json?

  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [clubId, roleId], references: [clubId, id], onDelete: Restrict)
  member Member?

  notifications      Notification[]
  calendarFeedTokens CalendarFeedToken[]

  @@unique([clubId, userId])
  @@index([userId])
  @@index([clubId, roleId])
}

model Invitation {
  id              String    @id @default(uuid(7))
  clubId          String
  email           String
  roleId          String
  /// Optional: bestehender Mitgliedsdatensatz, der mit dem neuen Konto verknüpft werden soll.
  memberId        String?
  tokenHash       String    @unique
  invitedByUserId String?
  expiresAt       DateTime  @db.Timestamptz(3)
  acceptedAt      DateTime? @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [clubId, roleId], references: [clubId, id], onDelete: Restrict)
  member Member? @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Restrict)

  @@index([clubId, email])
  @@index([clubId, acceptedAt, revokedAt])
}

// ----------------------------------------------------------------------------
// Mitglieder, Abteilungen, Gruppen
// ----------------------------------------------------------------------------

model Member {
  id              String       @id @default(uuid(7))
  clubId          String
  /// Vereinsinterne Mitgliedsnummer (eindeutig je Verein).
  memberNumber    String?
  firstName       String
  lastName        String
  email           String?
  phone           String?
  street          String?
  postalCode      String?
  city            String?
  country         String?      @default("DE")
  birthDate       DateTime?    @db.Date
  joinedAt        DateTime?    @db.Date
  leftAt          DateTime?    @db.Date
  status          MemberStatus @default(ACTIVE)
  /// Funktion im Verein, z. B. "1. Vorsitzende", "Kassenwart".
  clubFunction    String?
  /// Interne Notizen – nur für berechtigte Rollen sichtbar.
  internalNotes   String?
  /// Verweis auf ein Document (Profilbild); bewusst ohne Fremdschlüssel (vermeidet Zirkel).
  photoDocumentId String?
  /// Verknüpftes Benutzerkonto (Mitgliedschaft im selben Verein erforderlich).
  userId          String?
  archivedAt      DateTime?    @db.Timestamptz(3)
  deletedAt       DateTime?    @db.Timestamptz(3)
  /// Gesetzt, wenn die personenbezogenen Daten gelöscht/anonymisiert wurden (Art. 17 DSGVO).
  anonymizedAt    DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  club       Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  membership ClubMembership? @relation(fields: [clubId, userId], references: [clubId, userId], onDelete: Restrict)

  departments            MemberDepartment[]
  groups                 GroupMember[]
  consents               Consent[]
  participations         EventParticipant[]
  shiftAssignments       ShiftAssignment[]
  contactForEvents       Event[]                 @relation("EventContact")
  responsibleShifts      EventShift[]            @relation("ShiftResponsible")
  assignedTasks          Task[]                  @relation("TaskAssignee")
  checklistItems         ChecklistItem[]         @relation("ChecklistItemAssignee")
  documents              Document[]
  invitations            Invitation[]
  messageRecipients      MessageRecipient[]
  /// Beitrittsantrag, aus dem das Mitglied angelegt wurde.
  membershipApplications MembershipApplication[]
  /// Buchungen, bei denen das Mitglied Zahler oder Empfänger war (Kassenbuch).
  ledgerEntries          LedgerEntry[]
  statusChanges          MemberStatusChange[]
  finance                MemberFinance?          @relation("MemberFinanceOf")
  /// Mitglieder, für die dieses Mitglied zahlt.
  paysFor                MemberFinance[]         @relation("MemberFinancePayer")
  feeAssignments         MemberFeeAssignment[]

  @@unique([clubId, id])
  @@unique([clubId, memberNumber])
  @@unique([clubId, userId])
  @@index([clubId, status])
  @@index([clubId, lastName, firstName])
  @@index([clubId, archivedAt, deletedAt])
}

model Department {
  id          String   @id @default(uuid(7))
  clubId      String
  name        String
  description String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  club                   Club                    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members                MemberDepartment[]
  groups                 Group[]
  events                 Event[]
  messages               Message[]
  membershipApplications MembershipApplication[]
  /// Buchungszeilen, die dieser Abteilung zugeordnet sind (Töpfe, Auswertungen).
  ledgerLines            LedgerLine[]
  feeTypes               FeeType[]

  @@unique([clubId, id])
  @@unique([clubId, name])
}

/// Zuordnung Mitglied ↔ Abteilung. `isLeader` macht das Mitglied zum Abteilungsleiter.
model MemberDepartment {
  clubId       String
  memberId     String
  departmentId String
  isLeader     Boolean   @default(false)
  since        DateTime? @db.Date
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  member     Member     @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Cascade)
  department Department @relation(fields: [clubId, departmentId], references: [clubId, id], onDelete: Cascade)

  @@id([memberId, departmentId])
  @@index([clubId, departmentId])
}

/// Gruppen/Teams, optional innerhalb einer Abteilung.
model Group {
  id           String   @id @default(uuid(7))
  clubId       String
  departmentId String?
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  club       Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [clubId, departmentId], references: [clubId, id], onDelete: Restrict)
  members    GroupMember[]
  tasks      Task[]

  @@unique([clubId, id])
  @@index([clubId, departmentId])
}

model GroupMember {
  clubId    String
  groupId   String
  memberId  String
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  group  Group  @relation(fields: [clubId, groupId], references: [clubId, id], onDelete: Cascade)
  member Member @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Cascade)

  @@id([groupId, memberId])
  @@index([clubId, memberId])
}

/// Protokoll von Einwilligungen (Nachweispflicht nach DSGVO). Der aktuelle Status ist der
/// jeweils neueste Eintrag je Member und Typ; Widerruf = neuer Eintrag mit granted = false.
model Consent {
  id          String      @id @default(uuid(7))
  clubId      String
  memberId    String
  type        ConsentType
  granted     Boolean
  /// Version des Einwilligungstexts, auf die sich die Zustimmung bezieht.
  textVersion String?
  /// Herkunft: "app", "paper", "import".
  source      String?
  recordedBy  String?
  recordedAt  DateTime    @default(now()) @db.Timestamptz(3)

  member Member @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Cascade)

  @@index([clubId, memberId, type, recordedAt])
}

/// Beitrittsantrag über den öffentlichen QR-Code-Link des Vereins. Wer ihn stellt, hat noch KEIN Konto und keinen Zugang:
/// Erst wenn der Vorstand annimmt, entsteht das Mitglied und bekommt eine Einladung per E-Mail (Mitglieder sehen Chats,
/// Termine und Dokumente). Entschiedene Anträge werden 30 Tage nach der Entscheidung gelöscht, offene nach 180 Tagen.
model MembershipApplication {
  id                 String                      @id @default(uuid(7))
  clubId             String
  firstName          String
  lastName           String
  /// Immer klein geschrieben gespeichert (Prüfregel in der Migration).
  email              String
  phone              String?
  birthDate          DateTime?                   @db.Date
  /// Gewünschte Abteilung (freiwillig). Wird die Abteilung gelöscht, leert der Dienst das Feld vorher.
  departmentId       String?
  /// Nachricht an den Verein – reiner Text, höchstens 1000 Zeichen.
  message            String?
  /// Zeitpunkt der Einwilligung, die Angaben zur Bearbeitung des Antrags zu speichern.
  consentAt          DateTime                    @db.Timestamptz(3)
  /// Fassung des Einwilligungstexts im Formular (`APPLICATION_CONSENT_VERSION`) – Nachweis, welchem Text zugestimmt wurde.
  /// Diese Einwilligung gilt nur für die Bearbeitung des Antrags und wird beim Annehmen NICHT als Einwilligung übernommen.
  consentTextVersion String
  status             MembershipApplicationStatus @default(PENDING)
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3)
  decidedAt          DateTime?                   @db.Timestamptz(3)
  /// Wer entschieden hat – Herkunftsangabe ohne Fremdschlüssel (wird beim Löschen des Kontos gelöst).
  decidedById        String?
  /// Beim Annehmen angelegtes Mitglied.
  memberId           String?
  /// Gekürzte IP des Absenders (Nachweis bei Missbrauch, Datensparsamkeit).
  ipPrefix           String?
  /// Über welchen QR-Code der Antrag kam (Zeitpunkt, zu dem dieser Code eingerichtet wurde) – nur wenn er noch der
  /// aktuelle ist, gibt Ablehnen den Platz zurück. Leer bei Anträgen von vor der Begrenzung über ältere Codes.
  joinLinkCreatedAt  DateTime?                   @db.Timestamptz(3)

  club       Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [clubId, departmentId], references: [clubId, id], onDelete: Restrict)
  member     Member?     @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Restrict)

  @@unique([clubId, id])
  @@index([clubId, status, createdAt])
}

// ----------------------------------------------------------------------------
// Veranstaltungen, Teilnehmer, Helferschichten
// ----------------------------------------------------------------------------

model Event {
  id                   String          @id @default(uuid(7))
  clubId               String
  /// Gemeinsame ID aller Termine einer Terminserie (wiederkehrende Termine).
  seriesId             String?
  title                String
  description          String?
  type                 EventType       @default(EVENT)
  status               EventStatus     @default(DRAFT)
  visibility           EventVisibility @default(INTERNAL)
  startsAt             DateTime        @db.Timestamptz(3)
  endsAt               DateTime        @db.Timestamptz(3)
  allDay               Boolean         @default(false)
  locationName         String?
  address              String?
  contactMemberId      String?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  /// Zielgruppe als Freitext, z. B. "Jugend ab 12 Jahren".
  targetAudience       String?
  departmentId         String?
  maxParticipants      Int?
  registrationRequired Boolean         @default(false)
  registrationDeadline DateTime?       @db.Timestamptz(3)
  waitlistEnabled      Boolean         @default(false)
  internalNotes        String?
  publishedAt          DateTime?       @db.Timestamptz(3)
  cancelledAt          DateTime?       @db.Timestamptz(3)
  cancelReason         String?
  createdById          String?
  deletedAt            DateTime?       @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  club          Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  department    Department?        @relation(fields: [clubId, departmentId], references: [clubId, id], onDelete: Restrict)
  contactMember Member?            @relation("EventContact", fields: [clubId, contactMemberId], references: [clubId, id], onDelete: Restrict)
  participants  EventParticipant[]
  shifts        EventShift[]
  tasks         Task[]
  checklists    Checklist[]
  documents     Document[]
  messages      Message[]
  /// Buchungszeilen dieser Veranstaltung (Ergebnis z. B. des Sommerfests).
  ledgerLines   LedgerLine[]

  @@unique([clubId, id])
  @@index([clubId, startsAt])
  @@index([clubId, status, startsAt])
  @@index([clubId, departmentId, startsAt])
  @@index([clubId, seriesId])
}

model EventParticipant {
  id          String            @id @default(uuid(7))
  clubId      String
  eventId     String
  memberId    String
  status      ParticipantStatus
  note        String?
  respondedAt DateTime          @default(now()) @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  event  Event  @relation(fields: [clubId, eventId], references: [clubId, id], onDelete: Cascade)
  member Member @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([clubId, eventId, status, createdAt])
  @@index([clubId, memberId])
}

model EventShift {
  id                  String      @id @default(uuid(7))
  clubId              String
  eventId             String
  /// Bezeichnung, z. B. "Getränkestand".
  title               String
  /// Aufgabe, z. B. "Getränke ausschenken und kassieren".
  taskName            String?
  description         String?
  startsAt            DateTime    @db.Timestamptz(3)
  endsAt              DateTime    @db.Timestamptz(3)
  meetingPoint        String?
  requiredCount       Int
  minAge              Int?
  requirements        String?
  internalNotes       String?
  responsibleMemberId String?
  status              ShiftStatus @default(OPEN)
  deletedAt           DateTime?   @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  event       Event             @relation(fields: [clubId, eventId], references: [clubId, id], onDelete: Cascade)
  responsible Member?           @relation("ShiftResponsible", fields: [clubId, responsibleMemberId], references: [clubId, id], onDelete: Restrict)
  assignments ShiftAssignment[]

  @@unique([clubId, id])
  @@index([clubId, eventId])
  @@index([clubId, startsAt])
}

/// Eintragung eines Mitglieds in eine Schicht. Pro (Schicht, Mitglied) genau eine Zeile;
/// Abmeldung setzt den Status auf CANCELLED, erneute Anmeldung reaktiviert die Zeile.
model ShiftAssignment {
  id                String           @id @default(uuid(7))
  clubId            String
  shiftId           String
  memberId          String
  status            AssignmentStatus @default(CONFIRMED)
  /// Wer die Eintragung vorgenommen hat (Mitglied selbst oder Verantwortliche).
  assignedByUserId  String?
  assignedAt        DateTime         @default(now()) @db.Timestamptz(3)
  cancelledAt       DateTime?        @db.Timestamptz(3)
  /// Tatsächlich geleistete Minuten (Helferstunden); leer = noch nicht dokumentiert.
  workedMinutes     Int?
  hoursApprovedAt   DateTime?        @db.Timestamptz(3)
  hoursApprovedById String?
  reminderSentAt    DateTime?        @db.Timestamptz(3)
  note              String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  shift  EventShift @relation(fields: [clubId, shiftId], references: [clubId, id], onDelete: Cascade)
  member Member     @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Cascade)

  @@unique([shiftId, memberId])
  @@index([clubId, shiftId, status])
  @@index([clubId, memberId, status])
}

// ----------------------------------------------------------------------------
// Aufgaben und Checklisten
// ----------------------------------------------------------------------------

model Task {
  id               String       @id @default(uuid(7))
  clubId           String
  eventId          String?
  title            String
  description      String?
  assigneeMemberId String?
  groupId          String?
  dueDate          DateTime?    @db.Date
  status           TaskStatus   @default(OPEN)
  priority         TaskPriority @default(NORMAL)
  notes            String?
  completedAt      DateTime?    @db.Timestamptz(3)
  createdById      String?
  deletedAt        DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  club      Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event     Event?     @relation(fields: [clubId, eventId], references: [clubId, id], onDelete: Cascade)
  assignee  Member?    @relation("TaskAssignee", fields: [clubId, assigneeMemberId], references: [clubId, id], onDelete: Restrict)
  group     Group?     @relation(fields: [clubId, groupId], references: [clubId, id], onDelete: Restrict)
  documents Document[]

  @@unique([clubId, id])
  @@index([clubId, status, dueDate])
  @@index([clubId, assigneeMemberId, status])
  @@index([clubId, eventId])
}

model Checklist {
  id        String    @id @default(uuid(7))
  clubId    String
  eventId   String?
  title     String
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  club  Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event Event?          @relation(fields: [clubId, eventId], references: [clubId, id], onDelete: Cascade)
  items ChecklistItem[]

  @@unique([clubId, id])
  @@index([clubId, eventId])
}

model ChecklistItem {
  id               String    @id @default(uuid(7))
  clubId           String
  checklistId      String
  text             String
  position         Int       @default(0)
  isDone           Boolean   @default(false)
  doneAt           DateTime? @db.Timestamptz(3)
  doneById         String?
  assigneeMemberId String?
  dueDate          DateTime? @db.Date
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  checklist Checklist @relation(fields: [clubId, checklistId], references: [clubId, id], onDelete: Cascade)
  assignee  Member?   @relation("ChecklistItemAssignee", fields: [clubId, assigneeMemberId], references: [clubId, id], onDelete: Restrict)

  @@index([clubId, checklistId, position])
}

// ----------------------------------------------------------------------------
// Kommunikation
// ----------------------------------------------------------------------------

/// In-App-Benachrichtigung für einen Benutzer im Kontext eines Vereins.
model Notification {
  id          String           @id @default(uuid(7))
  clubId      String
  userId      String
  type        NotificationType
  title       String
  body        String?
  /// Interner, relativer Link (z. B. "/veranstaltungen/…"); niemals eine externe URL.
  linkUrl     String?
  readAt      DateTime?        @db.Timestamptz(3)
  /// Verhindert doppelte Erinnerungen (z. B. "shift-reminder:<assignmentId>:24h").
  dedupeKey   String?
  emailStatus EmailStatus      @default(NONE)
  emailSentAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  membership ClubMembership @relation(fields: [clubId, userId], references: [clubId, userId], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([clubId, userId, readAt, createdAt])
  @@index([emailStatus, createdAt])
}

model Message {
  id             String          @id @default(uuid(7))
  clubId         String
  authorUserId   String?
  subject        String
  /// Reiner Text (wird nie als HTML gerendert).
  body           String
  audience       MessageAudience
  departmentId   String?
  eventId        String?
  isAnnouncement Boolean         @default(false)
  sendInApp      Boolean         @default(true)
  sendEmail      Boolean         @default(false)
  status         MessageStatus   @default(DRAFT)
  scheduledAt    DateTime?       @db.Timestamptz(3)
  sentAt         DateTime?       @db.Timestamptz(3)
  recipientCount Int             @default(0)
  deletedAt      DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  club       Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  department Department?        @relation(fields: [clubId, departmentId], references: [clubId, id], onDelete: Restrict)
  event      Event?             @relation(fields: [clubId, eventId], references: [clubId, id], onDelete: Restrict)
  recipients MessageRecipient[]

  @@unique([clubId, id])
  @@index([clubId, status, scheduledAt])
  @@index([clubId, createdAt])
}

model MessageRecipient {
  id          String      @id @default(uuid(7))
  clubId      String
  messageId   String
  memberId    String
  userId      String?
  readAt      DateTime?   @db.Timestamptz(3)
  emailStatus EmailStatus @default(NONE)
  emailSentAt DateTime?   @db.Timestamptz(3)

  message Message @relation(fields: [clubId, messageId], references: [clubId, id], onDelete: Cascade)
  member  Member  @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Cascade)

  @@unique([messageId, memberId])
  @@index([clubId, userId, readAt])
  @@index([emailStatus])
}

// ----------------------------------------------------------------------------
// Hilfe und Support
// ----------------------------------------------------------------------------

/// Meldung eines Mitglieds an die Vereinsverwaltung: Problem, Frage oder Verbesserungsvorschlag.
/// Reiner Text; die Verwaltung kann antworten (die Antwort sieht die meldende Person).
model SupportTicket {
  id            String          @id @default(uuid(7))
  clubId        String
  /// Herkunftsangabe ohne Fremdschlüssel (wird beim Löschen des Kontos mit entfernt).
  createdById   String?
  category      SupportCategory
  subject       String
  description   String
  /// Interner Pfad der Seite, auf der das Problem auftrat (z. B. "/helferplanung"); nie eine externe Adresse.
  pagePath      String?
  /// Gekürzte Geräteangabe ("Edge auf Windows") – hilft bei der Fehlersuche.
  userAgent     String?
  status        SupportStatus   @default(OPEN)
  /// Antwort der Verwaltung; erscheint bei der meldenden Person.
  response      String?
  respondedAt   DateTime?       @db.Timestamptz(3)
  respondedById String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, id])
  @@index([clubId, status, createdAt])
  @@index([clubId, createdById, createdAt])
}

// ----------------------------------------------------------------------------
// Dokumente
// ----------------------------------------------------------------------------

model DocumentFolder {
  id        String   @id @default(uuid(7))
  clubId    String
  parentId  String?
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  parent    DocumentFolder?  @relation("FolderTree", fields: [clubId, parentId], references: [clubId, id], onDelete: Restrict)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]

  @@unique([clubId, id])
  @@index([clubId, parentId])
}

/// Metadaten einer hochgeladenen Datei. Die Datei selbst liegt außerhalb von /public im
/// Speicher (StorageProvider) und wird nur über eine berechtigte Route ausgeliefert.
model Document {
  id           String         @id @default(uuid(7))
  clubId       String
  /// Anzeigename (bereinigt).
  name         String
  /// Zufälliger, nicht erratbarer Schlüssel im Speicher – niemals der Originaldateiname.
  storageKey   String         @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  category     String?
  access       DocumentAccess @default(ALL_MEMBERS)
  folderId     String?
  eventId      String?
  memberId     String?
  taskId       String?
  uploadedById String?
  archivedAt   DateTime?      @db.Timestamptz(3)
  deletedAt    DateTime?      @db.Timestamptz(3)
  /// Beleg im Kassenbuch: aufbewahren bis zu diesem Tag (setzt die Datenbank beim Anhängen; Löschen bis dahin gesperrt).
  retainUntil  DateTime?      @db.Date
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  club              Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  folder            DocumentFolder?    @relation(fields: [clubId, folderId], references: [clubId, id], onDelete: Restrict)
  event             Event?             @relation(fields: [clubId, eventId], references: [clubId, id], onDelete: Cascade)
  member            Member?            @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Cascade)
  task              Task?              @relation(fields: [clubId, taskId], references: [clubId, id], onDelete: Cascade)
  /// Ist das Dokument eine Rechnung, stehen Betrag und Zahlungsstand hier.
  invoice           Invoice?
  ledgerAttachments LedgerAttachment[]

  @@unique([clubId, id])
  @@index([clubId, folderId])
  @@index([clubId, eventId])
  @@index([clubId, memberId])
}

/// Rechnung, die der Verein bezahlen muss. Der Beleg ist ein Dokument (1:1); die Rechnung trägt Betrag, Fälligkeit
/// und Zahlungsstand. Offen = Status OPEN, solange das Dokument weder gelöscht noch archiviert ist. Sehen und
/// bearbeiten dürfen nur Berechtigte (`finance:read` / `finance:manage`) – unabhängig davon, wer das Dokument sieht.
model Invoice {
  id          String        @id @default(uuid(7))
  clubId      String
  documentId  String
  /// Rechnungsdatum (Kalendertag in Berlin) – beim Hochladen der Tag des Hochladens.
  invoiceDate DateTime      @db.Date
  /// Betrag in ganzen Cent (nie Fließkommazahlen). Pflicht, solange die Rechnung offen ist.
  amountCents Int?
  dueDate     DateTime?     @db.Date
  status      InvoiceStatus @default(OPEN)
  /// Wann als bezahlt markiert (leer, wenn schon beim Hochladen „muss nicht mehr bezahlt werden“ gewählt wurde).
  paidAt      DateTime?     @db.Timestamptz(3)
  paidById    String?
  createdById String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  document    Document     @relation(fields: [clubId, documentId], references: [clubId, id], onDelete: Cascade)
  /// Buchungen im Kassenbuch, die diese Rechnung bezahlen.
  ledgerLines LedgerLine[]

  @@unique([clubId, id])
  @@unique([clubId, documentId])
  @@index([clubId, status, dueDate])
}

// ----------------------------------------------------------------------------
// Finanzen: Kassenbuch (nur hinzufügen – Korrekturen als Storno, siehe docs/adr/0010-finanzen-kassenbuch.md)
// ----------------------------------------------------------------------------

/// Grundeinstellungen der Finanzen je Verein (1:1). Wird beim Einrichten des Kassenbuchs angelegt.
model FinanceSettings {
  id                      String       @id @default(uuid(7))
  clubId                  String       @unique
  /// Ab diesem Tag führt der Verein das Kassenbuch in VereinsFlow; die Anfangsbestände tragen dieses Datum.
  ledgerStartDate         DateTime     @db.Date
  /// Bis einschließlich zu diesem Tag ist abgeschlossen (festgeschrieben). Nur der Monatsabschluss setzt es – und nur nach vorn.
  closedThrough           DateTime?    @db.Date
  /// Beiträge: Rhythmus des Beitragslaufs, Fälligkeit (Tag im ersten Monat), anteilige Berechnung, Altersregel.
  feeInterval             FeeInterval  @default(QUARTERLY)
  dueDay                  Int          @default(15)
  proRataEntry            ProRataEntry @default(DAY)
  proRataExit             ProRataExit  @default(DAY)
  ageRule                 AgeRule      @default(EXACT_DAY)
  missingBirthDateAsAdult Boolean      @default(true)
  minDebitCents           Int          @default(500)
  updatedById             String?
  createdAt               DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, id])
}

/// Geldkonto: Girokonto, Barkasse, PayPal … Der Kontostand ergibt sich aus den Buchungen.
model FinanceAccount {
  id          String             @id @default(uuid(7))
  clubId      String
  kind        FinanceAccountKind
  name        String
  /// Bank bzw. kurze Beschreibung („Sparkasse Musterstadt“, „Vereinsheim“).
  bankName    String?
  /// Das Bankkonto, das der Verein für Beiträge und Lastschrift nutzt (höchstens eins, siehe Migration).
  isDefault   Boolean            @default(false)
  sortOrder   Int                @default(0)
  archivedAt  DateTime?          @db.Timestamptz(3)
  createdById String?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  club       Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  entries    LedgerEntry[]
  cashCounts CashCount[]

  @@unique([clubId, id])
  @@unique([clubId, name])
}

/// Kategorie einer Einnahme oder Ausgabe in Alltagssprache („Hallen- und Platzmiete“) mit ihrem steuerlichen Bereich.
/// Die Buchungszeilen merken sich Name und Bereich zum Zeitpunkt der Buchung (Änderungen gelten nur für neue Buchungen).
model FinanceCategory {
  id         String            @id @default(uuid(7))
  clubId     String
  name       String
  direction  CategoryDirection
  sphere     Sphere
  /// Feste Kategorien, auf die sich das Programm verlässt (Beiträge, Spenden, Umbuchung, Anfangsbestand …).
  systemKey  String?
  /// Kurze Erklärung im Auswahlfeld, z. B. „ideeller Bereich“.
  hint       String?
  sortOrder  Int               @default(0)
  archivedAt DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)

  club     Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  lines    LedgerLine[]
  feeTypes FeeType[]

  @@unique([clubId, id])
  @@unique([clubId, name])
  @@unique([clubId, systemKey])
}

/// Lückenloser Nummernkreis (Buchungsnummern 2026-0042, Beitragsnummern …). Nur aufwärts, nie gelöscht.
model FinanceCounter {
  clubId    String
  kind      CounterKind
  /// Jahr des Nummernkreises (0 = nicht jährlich).
  year      Int
  lastValue Int         @default(0)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, kind, year])
}

/// Buchung im Kassenbuch (Kopf): ein Geschäftsvorfall auf einem Geldkonto. Betrag mit Vorzeichen (+ Einnahme, − Ausgabe),
/// aufgeteilt auf eine oder mehrere Zeilen (Kategorien). Unveränderlich – Korrektur nur durch Storno (Gegenbuchung).
model LedgerEntry {
  id                   String          @id @default(uuid(7))
  clubId               String
  /// Nummer innerhalb des Buchungsjahres, angezeigt als „2026-0042“.
  year                 Int
  number               Int
  accountId            String
  bookingDate          DateTime        @db.Date
  /// Datum des Belegs (Rechnung, Quittung), falls abweichend.
  documentDate         DateTime?       @db.Date
  kind                 LedgerEntryKind @default(STANDARD)
  amountCents          Int
  description          String
  /// Name des Zahlers bzw. Empfängers zum Zeitpunkt der Buchung.
  counterpartyName     String?
  counterpartyMemberId String?
  /// Storno: die Buchung, die hiermit aufgehoben wird.
  reversalOfId         String?
  /// Umbuchung: beide Hälften (Bank → Kasse) tragen dieselbe Kennung.
  transferGroupId      String?
  recordedAt           DateTime        @default(now()) @db.Timestamptz(3)
  createdById          String

  club               Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  account            FinanceAccount     @relation(fields: [clubId, accountId], references: [clubId, id], onDelete: Restrict)
  counterpartyMember Member?            @relation(fields: [clubId, counterpartyMemberId], references: [clubId, id], onDelete: Restrict)
  reversalOf         LedgerEntry?       @relation("LedgerReversal", fields: [clubId, reversalOfId], references: [clubId, id], onDelete: Restrict)
  reversedBy         LedgerEntry?       @relation("LedgerReversal")
  lines              LedgerLine[]
  attachments        LedgerAttachment[]
  /// Kassensturz, dessen Differenz diese Buchung festhält.
  cashCount          CashCount?

  @@unique([clubId, id])
  @@unique([clubId, year, number])
  @@unique([clubId, reversalOfId])
  @@index([clubId, accountId, bookingDate])
  @@index([clubId, bookingDate])
  @@index([clubId, counterpartyMemberId])
  @@index([clubId, transferGroupId])
}

/// Zeile einer Buchung: Betrag je Kategorie, optional mit Abteilung oder Veranstaltung. Bereich, Kategoriename, Datum und
/// Konto sind Momentaufnahmen (die Datenbank setzt sie beim Anlegen). Unveränderlich.
model LedgerLine {
  id           String   @id @default(uuid(7))
  clubId       String
  entryId      String
  position     Int
  amountCents  Int
  categoryId   String
  sphere       Sphere
  categoryName String
  departmentId String?
  eventId      String?
  note         String?
  bookingDate  DateTime @db.Date
  accountId    String
  /// Bezahlte Rechnung (Eingangsrechnung) – höchstens eine geltende Buchung je Rechnung.
  invoiceId    String?

  club       Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  entry      LedgerEntry     @relation(fields: [clubId, entryId], references: [clubId, id], onDelete: Restrict)
  category   FinanceCategory @relation(fields: [clubId, categoryId], references: [clubId, id], onDelete: Restrict)
  department Department?     @relation(fields: [clubId, departmentId], references: [clubId, id], onDelete: Restrict)
  event      Event?          @relation(fields: [clubId, eventId], references: [clubId, id], onDelete: Restrict)
  invoice    Invoice?        @relation(fields: [clubId, invoiceId], references: [clubId, id], onDelete: Restrict)

  @@unique([clubId, id])
  @@unique([clubId, entryId, position])
  @@index([clubId, bookingDate])
  @@index([clubId, categoryId, bookingDate])
  @@index([clubId, departmentId, bookingDate])
  @@index([clubId, eventId])
  @@index([clubId, invoiceId])
}

/// Beleg einer Buchung: eine Datei (Dokument „Nur Finanzen“, Rechnung …) oder ein Eigenbeleg als Text. Nicht änderbar;
/// entfernen nur, solange der Zeitraum offen ist (Trigger der Migration finance_receipts).
model LedgerAttachment {
  id           String   @id @default(uuid(7))
  clubId       String
  entryId      String
  documentId   String?
  /// Eigenbeleg: was bezahlt wurde und warum es keinen Beleg gibt.
  note         String?
  attachedAt   DateTime @default(now()) @db.Timestamptz(3)
  attachedById String?

  club     Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  entry    LedgerEntry @relation(fields: [clubId, entryId], references: [clubId, id], onDelete: Restrict)
  document Document?   @relation(fields: [clubId, documentId], references: [clubId, id], onDelete: Restrict)

  @@unique([clubId, id])
  @@unique([clubId, entryId, documentId])
  @@index([clubId, documentId])
}

// ----------------------------------------------------------------------------
// Datenschutz, Kalender-Abos, Audit
// ----------------------------------------------------------------------------

/// Persönlicher iCal-Abo-Link. Gespeichert wird nur der Hash des Tokens; der Link ist widerrufbar.
model CalendarFeedToken {
  id         String    @id @default(uuid(7))
  clubId     String
  userId     String
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  membership ClubMembership @relation(fields: [clubId, userId], references: [clubId, userId], onDelete: Cascade)

  @@index([clubId, userId])
}

/// Antrag auf Löschung des Kontos bzw. der Mitgliedsdaten (Art. 17 DSGVO).
/// Bewusst ohne Fremdschlüssel: Der Antrag bleibt als Nachweis auch nach der Löschung bestehen.
model DeletionRequest {
  id                String                @id @default(uuid(7))
  userId            String
  clubId            String?
  status            DeletionRequestStatus @default(PENDING)
  reason            String?
  requestedAt       DateTime              @default(now()) @db.Timestamptz(3)
  /// Frühester Zeitpunkt der Ausführung (Bedenkzeit).
  scheduledFor      DateTime              @db.Timestamptz(3)
  processedAt       DateTime?             @db.Timestamptz(3)
  processedByUserId String?
  note              String?

  @@index([status, scheduledFor])
  @@index([userId])
}

/// Unveränderliches Protokoll wichtiger Änderungen. Die Anwendung legt nur Zeilen an und
/// ändert/löscht sie nie. `clubId` ist bei Plattform-Ereignissen leer.
model AuditLog {
  id          String         @id @default(uuid(7))
  clubId      String?
  actorUserId String?
  actorType   AuditActorType @default(USER)
  /// Ereignisname, z. B. "member.updated".
  action      String
  entityType  String
  entityId    String?
  summary     String?
  /// Änderungen (vorher/nachher). Sensible Felder werden vor dem Speichern maskiert.
  changes     Json?
  /// Gekürzte IP-Adresse.
  ipPrefix    String?
  requestId   String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  @@index([clubId, createdAt])
  @@index([clubId, entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Monatsabschluss: bis `closedThrough` festgeschrieben. Kontostände, Zahl der Buchungen und Prüfsumme setzt die
/// Datenbank (Migration finance_closing); die Prüfsumme ist mit der des Vormonats verkettet. Unveränderlich.
model FinancePeriodClose {
  id            String          @id @default(uuid(7))
  clubId        String
  closedThrough DateTime        @db.Date
  kind          PeriodCloseKind
  /// Kontostand je Konto am Ende des Zeitraums: { "<kontoId>": Cent }.
  balances      Json
  /// Buchungen in diesem Zeitraum.
  entryCount    Int
  /// Höchste Buchungsnummer bis dahin („2026-0042“).
  lastNumber    String?
  contentHash   String
  previousHash  String?
  note          String?
  closedAt      DateTime        @default(now()) @db.Timestamptz(3)
  closedById    String?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, id])
  @@unique([clubId, closedThrough])
}

/// Kassensturz: Bargeld gezählt und mit dem Kassenbuch verglichen. Eine Differenz ist als Buchung „Kassendifferenz“
/// festgehalten (`entryId`) und begründet (`note`). Unveränderlich.
model CashCount {
  id              String   @id @default(uuid(7))
  clubId          String
  accountId       String
  countedOn       DateTime @db.Date
  countedCents    Int
  /// Stand laut Kassenbuch beim Zählen.
  bookCents       Int
  differenceCents Int
  /// Zählhilfe: Anzahl je Schein/Münze in Cent, z. B. { "5000": 2, "200": 7 }.
  denominations   Json?
  note            String?
  entryId         String?
  countedAt       DateTime @default(now()) @db.Timestamptz(3)
  countedById     String?

  club    Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  account FinanceAccount @relation(fields: [clubId, accountId], references: [clubId, id], onDelete: Restrict)
  entry   LedgerEntry?   @relation(fields: [clubId, entryId], references: [clubId, id], onDelete: Restrict)

  @@unique([clubId, id])
  @@unique([clubId, entryId])
  @@index([clubId, accountId, countedOn])
}

/// Status-Verlauf eines Mitglieds (für Beiträge tageweise richtig). Schreibt die Datenbank selbst bei jeder Anlage und
/// Statusänderung (Trigger Member_status_history); Einträge werden nicht geändert.
model MemberStatusChange {
  id        String       @id @default(uuid(7))
  clubId    String
  memberId  String
  status    MemberStatus
  validFrom DateTime     @db.Date
  /// Zeitpunkt der Erfassung auf die Mikrosekunde (legt die Reihenfolge fest; JavaScript sieht nur Millisekunden).
  createdAt DateTime     @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Cascade)

  @@unique([clubId, id])
  @@index([clubId, memberId, validFrom])
}

/// Beitragsart mit ihren Regeln; die Beträge stehen als Sätze mit „gilt ab“ in FeeRate.
model FeeType {
  id               String         @id @default(uuid(7))
  clubId           String
  name             String
  kind             FeeTypeKind
  /// Kategorie im Kassenbuch für Zahlungen (leer = „Mitgliedsbeiträge“).
  categoryId       String?
  /// Grundbeitrag: nur für Mitglieder dieser Abteilung; Zusatzbeitrag: Beitrag der Abteilung.
  departmentId     String?
  /// Für welche Status (leer = aktiv, passiv, gesperrt).
  statuses         MemberStatus[] @default([])
  minAge           Int?
  maxAge           Int?
  familyMinMembers Int?
  /// Grundbeiträge werden in dieser Reihenfolge geprüft (eindeutig, kleiner zuerst).
  priority         Int            @default(100)
  description      String?
  archivedAt       DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  club        Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  category    FinanceCategory?      @relation(fields: [clubId, categoryId], references: [clubId, id], onDelete: Restrict)
  department  Department?           @relation(fields: [clubId, departmentId], references: [clubId, id], onDelete: Restrict)
  rates       FeeRate[]
  assignments MemberFeeAssignment[]

  @@unique([clubId, id])
  @@unique([clubId, name])
}

/// Beitragssatz ab einem Tag. Nicht änderbar; löschen nur, solange er noch nicht gilt.
model FeeRate {
  id          String      @id @default(uuid(7))
  clubId      String
  feeTypeId   String
  validFrom   DateTime    @db.Date
  amountCents Int
  interval    FeeInterval
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  createdById String?

  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  feeType FeeType @relation(fields: [clubId, feeTypeId], references: [clubId, id], onDelete: Cascade)

  @@unique([clubId, id])
  @@unique([clubId, feeTypeId, validFrom])
}

/// Beitragsangaben eines Mitglieds: wer zahlt (z. B. ein Elternteil) und wie.
model MemberFinance {
  id            String        @id @default(uuid(7))
  clubId        String
  memberId      String
  payerMemberId String?
  paymentMethod PaymentMethod @default(TRANSFER)
  note          String?
  updatedById   String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member Member  @relation("MemberFinanceOf", fields: [clubId, memberId], references: [clubId, id], onDelete: Cascade)
  payer  Member? @relation("MemberFinancePayer", fields: [clubId, payerMemberId], references: [clubId, id], onDelete: Restrict)

  @@unique([clubId, id])
  @@unique([clubId, memberId])
  @@index([clubId, payerMemberId])
}

/// Feste Beitragsart, Befreiung, Ermäßigung oder fester Betrag – mit Zeitraum und Grund. Je Tag höchstens eine feste
/// Beitragsart und eine andere Regel (Ausschlussbedingung in der Datenbank).
model MemberFeeAssignment {
  id          String            @id @default(uuid(7))
  clubId      String
  memberId    String
  kind        FeeAssignmentKind
  feeTypeId   String?
  /// Ermäßigung in Basispunkten (5000 = 50 %).
  percentBp   Int?
  /// Fester Betrag je Monat in Cent.
  amountCents Int?
  validFrom   DateTime          @db.Date
  validTo     DateTime?         @db.Date
  reason      String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  createdById String?
  endedById   String?

  club    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member  Member   @relation(fields: [clubId, memberId], references: [clubId, id], onDelete: Cascade)
  feeType FeeType? @relation(fields: [clubId, feeTypeId], references: [clubId, id], onDelete: Restrict)

  @@unique([clubId, id])
  @@index([clubId, memberId, validFrom])
}
