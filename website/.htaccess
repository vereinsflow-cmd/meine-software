# VereinsFlow – Website (statisch). Für Apache-Webspace, wie ihn viele deutsche Hoster anbieten.
# Alle Blöcke sind mit <IfModule> abgesichert: Fehlt ein Modul, wird der Block einfach übersprungen.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  # Immer https://vereins-flow.com (ohne „www.“, so lautet auch die kanonische Adresse). Die Prüfung über den Port
  # entspricht der IONOS-Anleitung. Bei einer anderen Domain auch die Adresse hier anpassen.
  RewriteEngine On
  RewriteCond %{SERVER_PORT} !=443 [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://vereins-flow.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Die Seite lädt nur eigene Dateien und braucht weder Inline-Skripte noch Inline-Stile.
  # Wer später etwas Fremdes einbindet (Statistik, Karte, Video), muss diese Richtlinie – und die Datenschutzerklärung – anpassen.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # HSTS: Browser rufen die Domain ein Jahr lang nur noch über HTTPS auf (auch wenn jemand „http://“ tippt). Bewusst nur
  # für vereins-flow.com selbst – ohne includeSubDomains und ohne preload, damit Subdomains ohne Zertifikat nicht gesperrt
  # werden. Kommt die Angabe über http:// (Weiterleitung oben), beachten Browser sie nicht – sie schadet dort also nicht.
  # Das SSL-Zertifikat bei IONOS deshalb nie auslaufen lassen.
  Header always set Strict-Transport-Security "max-age=31536000"

  # HTML-Seiten: Der Browser darf sie behalten, fragt aber vor jeder Anzeige nach, ob es eine neuere gibt (unveränderte
  # Seiten kommen als kurze Antwort „304“). So sehen Besucher nach einer Änderung sofort die neue Seite – samt den neuen
  # ?v=-Adressen von Stil, Skript und Bildern. Gilt auch für die Startseite unter „/“ (Apache liefert dort index.html).
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Gepackt ausgelieferte Dateien bekommen von mod_deflate ein ETag mit „-gzip“ am Ende, das Apache bei der Nachfrage
  # nicht wiedererkennt – ohne diese Zeile käme statt „304“ jedes Mal die ganze Datei. Ändert nur die Nachfrage des Browsers.
  RequestHeader edit "If-None-Match" "^\"(.*)-gzip\"$" "\"$1\""
</IfModule>

<IfModule mod_expires.c>
  # Dateinamen enthalten keine Prüfsummen, deshalb nur kurze Zwischenspeicherung
  ExpiresActive On
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

<IfModule mod_deflate.c>
  # AddOutputFilterByType gehört zu mod_filter – ohne diesen Block gäbe es sonst einen 500-Fehler, falls mod_filter fehlt
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/json text/xml application/xml
  </IfModule>
</IfModule>
