 "sections": [
  {
   "id": 0,
   "name": "Hook",
   "scene": "hook",
   "text": "Ihr Verein läuft immer noch über Excel?",
   "start": 0.34,
   "end": 2.094
  },
  {
   "id": 1,
   "name": "Problem",
   "scene": "problem",
   "text": "Dienstagabend, nach der Arbeit. Die Liste gibt es dreimal. Im Chat zweihundert Nachrichten.",
   "start": 2.97,
   "end": 7.774
  },
  {
   "id": 2,
   "name": "Frage",
   "scene": "frage",
   "text": "Und wer kommt am Donnerstag?",
   "start": 8.65,
   "end": 9.852
  },
  {
   "id": 3,
   "name": "Mitglieder",
   "scene": "mitglieder",
   "text": "Mit VereinsFlow sind alle Mitglieder an einem Ort. Ihre Excel-Liste nehmen Sie mit. Fehler fallen schon vor dem Speichern auf.",
   "start": 10.71,
   "end": 17.639
  },
  {
   "id": 4,
   "name": "Termine",
   "scene": "termine",
   "text": "Das Training am Donnerstag steht im Kalender. Wer kommt, sagt zu. Wer nicht kann, Ganz ohne Rundfrage im Chat.",
   "start": 18.44,
   "end": 25.595
  },
  {
   "id": 5,
   "name": "Helfer",
   "scene": "helfer",
   "text": "Fürs Sommerfest tragen sich die Helfer per Fingertipp selbst ein. Und wo noch jemand fehlt, erkennen Sie auf einen Blick.",
   "start": 26.33,
   "end": 31.495
  },
  {
   "id": 6,
   "name": "Nachrichten",
   "scene": "nachrichten",
   "text": "Ihre Nachricht geht an alle, an eine Abteilung oder nur an die Helfer. Und Sie sehen, wie viele schon gelesen haben.",
   "start": 32.32,
   "end": 38.005
  },
  {
   "id": 7,
   "name": "Finanzen",
   "scene": "finanzen",
   "text": "Bleibt noch die Kasse. Beiträge, Rechnungen und das Kassenbuch mit Belegen. Offene Rechnungen sehen Sie sofort.",
   "start": 38.93,
   "end": 45.379
  },
  {
   "id": 8,
   "name": "Feierabend",
   "scene": "feierabend",
   "text": "Dann ist Feierabend.",
   "start": 46.25,
   "end": 47.17
  },
  {
   "id": 9,
   "name": "Leitsatz",
   "scene": "leitsatz",
   "text": "Vereinsarbeit ist Ehrenamt. Die Verwaltung sollte es nicht schwerer machen.",
   "start": 47.9,
   "end": 51.384
  },
  {
   "id": 10,
   "name": "Logo",
   "scene": "logo",
   "text": "VereinsFlow. Bringt Vereinsarbeit in Fluss.",
   "start": 52.18,
   "end": 55.198
  },
  {
   "id": 11,
   "name": "Endkarte",
   "scene": "endkarte",
   "text": "Jetzt Demo anfragen.",
   "start": 55.86,
   "end": 57.165
  }
 ],
